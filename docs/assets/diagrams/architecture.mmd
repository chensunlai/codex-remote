---
config:
  theme: base
  fontFamily: 'Noto Sans CJK SC, sans-serif'
  markdownAutoWrap: false
  themeCSS: ".edgeLabel .background { fill: #ffffff !important; opacity: 1 !important; }"
  themeVariables:
    fontSize: 16px
    lineColor: '#64748b'
    edgeLabelBackground: '#ffffff'
  flowchart:
    htmlLabels: false
    curve: linear
    nodeSpacing: 28
    rankSpacing: 48
    padding: 20
    wrappingWidth: 240
---
flowchart LR
    app("Android App
WebView")
    gateway("Gateway")

    subgraph agent["Agent"]
        direction TB
        host("Node.js
VS Code API")
        extension("extension.js")
        codex("Codex App Server")
        host <--> extension <--> codex
    end

    app <-->|HTTPS / WSS| gateway
    gateway <-->|WSS| agent

    classDef mobile fill:#eff6ff,stroke:#93c5fd,color:#172554,stroke-width:1.5px
    classDef relay fill:#f1f5f9,stroke:#cbd5e1,color:#334155,stroke-width:1.5px
    classDef official fill:#f0fdfa,stroke:#5eead4,color:#134e4a,stroke-width:1.5px
    class app mobile
    class gateway,host relay
    class extension,codex official
    style agent fill:#fafbfc,stroke:#cbd5e1,color:#334155,stroke-width:1px
    linkStyle default stroke:#64748b,stroke-width:1.5px
