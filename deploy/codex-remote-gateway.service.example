[Unit]
Description=Codex Remote Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codex-remote
Group=codex-remote
WorkingDirectory=/var/lib/codex-remote
EnvironmentFile=/etc/codex-remote/gateway.env
ExecStart=/usr/local/bin/codex-remote-gateway start
Restart=on-failure
RestartSec=3
StateDirectory=codex-remote
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/codex-remote
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
