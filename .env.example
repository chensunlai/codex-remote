# Gateway process settings. This file is a reference; load it through your
# process manager or shell.
HOST=0.0.0.0
PORT=6767
CODEX_REMOTE_DATA_DIR=.data

# Download and preview share this limit. Default: 10 MiB.
CODEX_REMOTE_MAX_DOWNLOAD_BYTES=10485760
CODEX_REMOTE_MAX_UPLOAD_BYTES=536870912
LOG_LEVEL=info

# Optional bootstrap tokens, comma-separated. Prefer the token CLI for normal
# user creation. A token is generated on first start when none exists.
# CODEX_REMOTE_API_TOKENS=

# Optional native TLS. When unset, Gateway serves HTTP/WS for a reverse proxy.
# CODEX_REMOTE_TLS_KEY=/path/to/key.pem
# CODEX_REMOTE_TLS_CERT=/path/to/cert.pem
