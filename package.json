{
  "name": "codex-remote",
  "version": "1.0.3",
  "private": true,
  "workspaces": [
    "server",
    "agent"
  ],
  "scripts": {
    "android:create-signing-key": "node scripts/create-android-signing-key.mjs",
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspace server",
    "start": "npm run start --workspace server",
    "agent": "npm run start --workspace agent",
    "package:binaries": "node scripts/package-binaries.mjs",
    "sync:terminal": "node scripts/sync-terminal-assets.mjs",
    "frontend:import": "node scripts/import-official-frontend.mjs",
    "frontend:smoke": "node scripts/smoke-official-frontend.mjs",
    "test": "npm run test --workspaces && npm run test:frontend",
    "test:frontend": "node --test frontend-host/*.test.mjs scripts/import-official-frontend.test.mjs scripts/install.test.mjs",
    "typecheck": "npm run typecheck --workspaces"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bun": "1.3.14"
  }
}
